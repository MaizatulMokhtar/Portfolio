                    <span x-text="skillsOpen ? 'Hide Skills' : 'Gained Skills'"></span>
                  </button>

                  <div x-show="skillsOpen" x-transition class="mt-3 grid grid-cols-2 gap-4 text-sm text-gray-700">
                    <div>
                      <strong class="block text-gray-900 mb-1">Frontend Development</strong>
                      <ul class="list-disc pl-5">
                        <li>HTML5 & CSS3</li>
                        <li>JavaScript</li>
                        <li>Bootstrap</li>
                        <li>jQuery</li>
                      </ul>

                      <strong class="block text-gray-900 mt-4 mb-1">Backend Development</strong>
                      <ul class="list-disc pl-5">
                        <li>PHP</li>
                        <li>MySQL</li>
                        <li>Laravel Blade (templating)</li>
                      </ul>
                    </div>

                    <div>
                      <strong class="block text-gray-900 mb-1">Tools & Platforms</strong>
                      <ul class="list-disc pl-5">
                        <li>PHPMyAdmin</li>
                        <li>Git</li>
                        <li>VS Code</li>
                        <li>Chrome DevTools</li>
                      </ul>

                      <strong class="block text-gray-900 mt-4 mb-1">Design & Testing</strong>
                      <ul class="list-disc pl-5">
                        <li>Figma</li>
                        <li>Canva</li>
                        <li>Manual Testing</li>
                        <li>User Acceptance Testing (UAT)</li>
                        <li>Test Cases and Documentation</li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </section>

        <section id="projects" class="tab-content hidden w-full">
          <h2 class="text-3xl sm:text-4xl font-bold text-blue-700 mb-6">Projects</h2>

          <!-- Projects Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 w-full">
            <!-- Project 1 -->
            <div class="bg-gray-900 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition transform hover:scale-105">
              <div class="bg-gradient-to-r from-blue-600 to-blue-700 h-32 flex items-center justify-center">
                <i class="fas fa-globe text-white text-4xl"></i>
              </div>
              <div class="p-4">
                <h3 class="text-lg font-bold text-blue-400 mb-2">Portfolio Website</h3>
                <p class="text-sm text-gray-300 mb-4">A responsive personal portfolio showcasing my projects, skills, and experience with modern web design.</p>
                <div class="flex flex-wrap gap-2 mb-4">
                  <span class="text-xs bg-blue-700 text-white px-2 py-1 rounded">HTML5</span>
                  <span class="text-xs bg-blue-700 text-white px-2 py-1 rounded">CSS3</span>
                  <span class="text-xs bg-blue-700 text-white px-2 py-1 rounded">Tailwind</span>
                </div>
                <a href="#" target="_blank" class="text-blue-400 hover:text-blue-300 text-sm font-semibold">View Project →</a>
              </div>
            </div>

             <!-- Project 2 -->
            <div class="bg-gray-900 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition transform hover:scale-105">
              <div class="bg-gradient-to-r from-green-600 to-green-700 h-32 flex items-center justify-center">
                <i class="fas fa-pencil-alt text-white text-4xl"></i>
              </div>
              <div class="p-4">
                <h3 class="text-lg font-bold text-green-400 mb-2">Blog Platform</h3>
                <p class="text-sm text-gray-300 mb-4">Full-stack blog application with CRUD functionality, user authentication, and content management system.</p>
                <div class="flex flex-wrap gap-2 mb-4">
                  <span class="text-xs bg-green-700 text-white px-2 py-1 rounded">Laravel</span>
                  <span class="text-xs bg-green-700 text-white px-2 py-1 rounded">MySQL</span>
                  <span class="text-xs bg-green-700 text-white px-2 py-1 rounded">PHP</span>
                </div>
                <a href="#" target="_blank" class="text-green-400 hover:text-green-300 text-sm font-semibold">View Project →</a>
              </div>
            </div>

            <!-- Project 3 -->
