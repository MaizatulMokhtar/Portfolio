              </button>
              <div class="hidden dropdown-menu bg-gray-800 text-white text-sm rounded shadow-lg absolute right-0 mt-2">
                <button onclick="openModal('coursesModal')" class="block px-4 py-2 hover:bg-blue-700 w-full text-left">
