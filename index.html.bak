                      <strong class="block text-gray-900 mb-1">Frontend Development</strong>
                      <ul class="list-disc pl-5">
                        <li>JavaScript</li>
                        <li>Alpine.js</li>
                        <li>Tailwind CSS</li>
                        <li>AJAX</li>
                      </ul>

                      <strong class="block text-gray-900 mt-4 mb-1">Backend Development</strong>
                      <ul class="list-disc pl-5">
                        <li>Laravel</li>
                        <li>REST API development</li>
                        <li>MySQL</li>
                      </ul>

                      <strong class="block text-gray-900 mt-4 mb-1">Testing</strong>
                      <ul class="list-disc pl-5">
                        <li>Manual Testing</li>
                        <li>Regression Testing</li>
                        <li>White Box & Black Box Testing</li>

                      </ul>
                    </div>

                    <div>
