<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Script -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>

  <!-- Importing Inter and Poppins -->
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Poppins:wght@400;500;700&display=swap"
    rel="stylesheet" />

  <!-- Font Awesome for icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <title>Maizatul Mokhtar - Portfolio</title>
  <meta name="description" content="Maizatul Mokhtar - Junior Full Stack Developer Portfolio" />
  <style>
    * {
      scroll-behavior: smooth;
    }
    
    html {
      scroll-behavior: smooth;
    }
    
    body {
      font-family: 'Poppins', sans-serif;
    }

    /* Fade in animation for sections */
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes slideInLeft {
      from {
        opacity: 0;
        transform: translateX(-30px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes slideInRight {
      from {
        opacity: 0;
        transform: translateX(30px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    .animate-fade-in {
      animation: fadeInUp 0.8s ease-out forwards;
    }

    .animate-slide-left {
      animation: slideInLeft 0.8s ease-out forwards;
    }

    .animate-slide-right {
      animation: slideInRight 0.8s ease-out forwards;
    }

    .section {
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding: 80px 20px 40px;
      scroll-margin-top: 80px;
    }

    .scroll-spy.active {
      color: #2563eb;
      font-weight: bold;
    }
  </style>
</head>

<body class="bg-black text-white">
  <div class="min-h-screen flex flex-col">
    <!-- Navbar -->
    <header class="bg-black shadow-md py-4 px-6 sticky top-0 z-50">
      <div class="flex items-center justify-between max-w-7xl mx-auto">
        <span class="text-xl sm:text-2xl font-bold text-blue-700">Maizatul</span>
        
        <!-- Mobile menu button -->
        <button id="mobileMenuBtn" class="md:hidden text-gray-300 hover:text-blue-700 transition text-2xl">
          <i class="fas fa-bars"></i>
        </button>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex space-x-6 text-gray-300 font-medium" id="navbar">
          <a href="#home" class="scroll-spy hover:text-blue-700 transition active" data-section="home">
            Home
          </a>
          <a href="#education" class="scroll-spy hover:text-blue-700 transition" data-section="education">
            Education
          </a>
          <a href="#experiences" class="scroll-spy hover:text-blue-700 transition" data-section="experiences">
            Experiences
          </a>
          <a href="#projects" class="scroll-spy hover:text-blue-700 transition" data-section="projects">
            Projects
          </a>
          <a href="#contact" class="scroll-spy hover:text-blue-700 transition" data-section="contact">
            Contact
          </a>
        </nav>
      </div>

      <!-- Mobile Navigation -->
      <nav id="mobileMenu" class="hidden md:hidden mt-4 flex flex-col space-y-3 text-gray-300 font-medium bg-gray-900 p-4 rounded-lg">
        <a href="#home" class="scroll-spy hover:text-blue-700 transition active text-left" data-section="home">
          Home
        </a>
        <a href="#education" class="scroll-spy hover:text-blue-700 transition text-left" data-section="education">
          Education
        </a>
        <a href="#experiences" class="scroll-spy hover:text-blue-700 transition text-left" data-section="experiences">
          Experiences
        </a>
        <a href="#projects" class="scroll-spy hover:text-blue-700 transition text-left" data-section="projects">
          Projects
        </a>
        <a href="#contact" class="scroll-spy hover:text-blue-700 transition text-left" data-section="contact">
          Contact
        </a>
      </nav>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 flex flex-col lg:flex-row max-w-7xl mx-auto w-full">
      <!-- Left Image - Responsive -->
      <div class="w-full lg:w-1/2 flex items-center justify-center py-10 px-4">
        <img src="assets/img/home.jpg" alt="Profile"
          class="w-64 h-64 sm:w-80 sm:h-80 lg:w-96 lg:h-96 rounded-full object-cover border-4 border-blue-700 shadow-lg" />
      </div>

      <!-- Right Content (Tabs) - Responsive -->
      <div class="w-full lg:w-1/2 flex flex-col items-start px-4 sm:px-6 py-10 overflow-y-auto max-h-[calc(100vh-100px)]">
        <!-- Home Tab -->
        <section id="home" class="tab-content">
          <div class="home-content text-center md:text-left max-w-xl mt-20">
            <h1 class="text-3xl md:text-5xl font-bold mb-3">
              Hi, it's <span class="text-blue-700">Maizatul</span>
            </h1>
            <h3 class="typing-text text-xl md:text-2xl font-bold mb-4">
              I'm a
              <span class="text-blue-700">Junior Full Stack Developer</span>
            </h3>
            <p class="mb-6">
              Skilled in HTML, CSS, JavaScript, PHP, and Laravel, with academic experience in Java
              and C++. Certified in CPRE-FL and CTFL from MSTB, I’m passionate about
              software quality and building responsive, user-friendly
              websites. I’m adaptable, detail-oriented, and thrive in
              collaborative environments where I can learn and contribute.
            </p>
            <div class="social-icons">
              <div class="flex justify-start gap-6 mt-6 mb-6">
                <!-- LinkedIn -->
                <a href="https://www.linkedin.com/in/maizatul-mokhtar-1135aa295" target="_blank"
                  class="w-12 h-12 rounded-full bg-blue-200 text-white flex items-center justify-center shadow-md hover:scale-110 transition">
                  <img src="assets/img/linkedin.svg" alt="LinkedIn" class="w-6 h-6" />
                </a>

                <!-- Gmail -->
                <a href="mailto:maizatulmokhtar85@gmail.com"
                  class="w-12 h-12 rounded-full bg-white text-white flex items-center justify-center shadow-md hover:scale-110 transition">
                  <img src="assets/img/gmail.svg" alt="InstGmailagram" class="w-6 h-6" />
                </a>

                <!-- Instagram -->
                <a href="https://instagram.com/myzatul.mokhtar" target="_blank"
                  class="w-12 h-12 rounded-full bg-gradient-to-tr from-pink-500 via-red-500 to-yellow-500 text-white flex items-center justify-center shadow-md hover:scale-110 transition">
                  <img src="assets/img/instagram.svg" alt="Instagram" class="w-6 h-6" />
                </a>
              </div>

              <!-- Contact me -->
