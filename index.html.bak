                        <li>Laravel</li>
                        <li>Tailwind CSS</li>
                        <li>Alpine.js</li>
                        <li>WordPress</li>
                        <li>Git & GitHub</li>
                        <li>cPanel</li>
                        <li>PHPMyAdmin</li>
                      </ul>

                      <strong class="block text-gray-900 mt-4 mb-1">Performance & SEO</strong>
                      <ul class="list-disc pl-5">
                        <li>Page speed optimization</li>
                        <li>Metadata setup</li>
                        <li>SEO tagging</li>
                      </ul>

                      <strong class="block text-gray-900 mt-4 mb-1">Testing & DevOps</strong>
